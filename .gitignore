# Gitignore for a React Frontend and .NET Backend Project

### React Frontend specific ignores
# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist
/out
/obj

# misc
.DS_Store
.env.local
.env*.local
.next
.vercel
.turbo

### .NET Backend specific ignores
# Build results
[Dd]ebug/
[Rr]elease/
*.suo
*.user
*.log
*.bak
*.ncb
*.opensdf
*.sdf
*.cache
*.obj
*.pdb
*.dll
*.exe

# Visual Studio and other IDE files
.vs/
.vscode/

# Package Manager files
/packages

# Rider
.idea/

# Other
appsettings.Development.json
appsettings.Production.json
```
